APP_NAME=fastapp
APP_ENV=dev
APP_DEBUG=false
APP_PORT=9501
APP_WS_PORT=9502
APP_DOC_PORT=9503

DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
# mysql 时为库名；sqlite 时为 .sqlite 文件绝对路径
DB_DATABASE=fastapp
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=redis
REDIS_AUTH=
REDIS_PORT=6379
REDIS_DB=0

# WebSocket 状态存储：redis=多 Worker 生产；cache=本地无 Redis 仅 Controller 流程
WS_STORE_DRIVER=redis

APP_URL=http://127.0.0.1:9501

JWT_TTL=3600
JWT_REFRESH_TTL=7200
JWT_SECRET=azOVxs
JWT_API_SECRET=azOVxs

# http代理（可选，仅显式配置时使用；不配置则直连。采集服务 tools/collect_service 等）
# HTTP_PROXY=http://127.0.0.1:7890

# StoryStudio
SCHEDULER_URL=http://127.0.0.1:8312
# .story 包签/验（Story Package Protocol）；与 inferkit 协议无关，单独配置
STORY_PACKAGE_SIGN_SECRET=
STORY_PACKAGE_SIGN_ALGO=sha256

# Tushare Token
# TUSHARE_TOKEN=your_tushare_token
