APP_NAME=fastapp
APP_ENV=dev
APP_DEBUG=false
APP_PORT=9501
APP_WS_PORT=9502
APP_DOC_PORT=9503

DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fastapp
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=redis
REDIS_AUTH=
REDIS_PORT=6379
REDIS_DB=0

APP_URL=http://127.0.0.1:9501

JWT_TTL=3600
JWT_REFRESH_TTL=7200
JWT_SECRET=azOVxs
JWT_API_SECRET=azOVxs

# http代理（可选，仅显式配置时使用；不配置则直连。采集服务 tools/collect_service 等）
# HTTP_PROXY=http://127.0.0.1:7890

# OCR 服务地址
# OCR_URL=http://127.0.0.1:8101

# MCP Playwright 服务地址
# MCP_PLAYWRIGHT_URL=http://127.0.0.1:8000

# LLM 服务地址
# LLM_URL=http://127.0.0.1:8100

# 东财行业资金流采集 Cookie
# EM_COOKIE=""
# 东财金价采 Cookie
# EM_COOKIE2=""

# Tushare Token
# TUSHARE_TOKEN=your_tushare_token
