{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FastApp Desktop Manifest",
  "type": "object",
  "required": ["app_version", "channel", "components"],
  "properties": {
    "app_version": { "type": "string" },
    "channel": { "type": "string", "enum": ["stable", "beta"] },
    "models_catalog_url": { "type": "string", "format": "uri" },
    "components": {
      "type": "object",
      "required": ["server"],
      "properties": {
        "server": { "$ref": "#/$defs/package" }
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "required": ["url", "sha256", "size", "version"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "version": { "type": "string" }
      }
    }
  }
}
