{
  "apps": [
    {
      "name": "blockchain-wallet",
      "script": "src/server.js",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000
      },
      "error_file": "logs/error.log",
      "out_file": "logs/output.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "max_memory_restart": "500M",
      "watch": false,
      "ignore_watch": ["node_modules", "logs", "*.log"],
      "kill_timeout": 5000
    }
  ]
}
