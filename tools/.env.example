# 复制为同目录 .env 后按需修改（勿提交 .env）
#   cp .env.example .env
#
# Story Studio：uv run python main.py start scheduler -d
# 推理参数以本文件为准；HTTP 请求体可覆盖（见 src/tools_env.py）
#
# ── 运行档（改 DEVICE + LLM_N_CTX 即可切换）────────────────────────────
# CPU · 32GB：     DEVICE=cpu   LLM_N_CTX=4096
# GPU · Apple：    DEVICE=mps   LLM_N_CTX=8192   （本文件默认）
# GPU · NVIDIA：   DEVICE=cuda  LLM_N_CTX=8192
# Darwin 省略 DEVICE 时自动 mps（可用）否则 cpu

# =============================================================================
# 1. 全局运行时
# =============================================================================
DEVICE=mps
TOOLS_MEMORY_PROFILE=32g
LLM_N_CTX=8192
BIND_HOST=127.0.0.1
LOGS_DIR=logs
HF_TOKEN=

# HF_ENDPOINT=https://hf-mirror.com
# HTTP_PROXY=
# HTTPS_PROXY=

# =============================================================================
# 2. Story Studio 核心（scheduler ensure 拉起）
# =============================================================================
# 模型须先手动下载：uv run python main.py download scheduler
# 本地路径固定为 models/*，不可通过 .env 覆盖

IP_ADAPTER_NUM_INFERENCE_STEPS=22

# =============================================================================
# 2b. 模型调优参考（按需取消注释；HTTP 请求体优先于 .env）
# =============================================================================
#
# 优先级：Story Studio 请求参数 > 本文件 .env > tools_env.py 代码默认
#
# --- 槽位 A · llm（Qwen2.5-7B GGUF）---
# LLM_N_CTX=8192              # 上下文 4K~16K；32GB GPU 推荐 8192，CPU 用 4096
# LLM_MAX_TOKENS=-1           # 单次生成长度上限，-1 不限制
# LLM_TEMPERATURE=0           # 0 确定性；略升可增加多样性
# LLM_GGUF_VERBOSE=1          # 调试 Metal/CUDA layer offload
#
# --- 槽位 B · sdxl_juggernaut（写实定妆）---
# SDXL_JUGGERNAUT_NUM_INFERENCE_STEPS=20   # 步数 ↑ 质量 ↑ 耗时 ↑
# SDXL_JUGGERNAUT_GUIDANCE_SCALE=5.0       # cfg；过高易过饱和
# SDXL_JUGGERNAUT_SEED=                     # 固定种子可复现
#
# --- 槽位 B · sdxl_illustrious（二次元定妆）---
# SDXL_ILLUSTRIOUS_NUM_INFERENCE_STEPS=28
# SDXL_ILLUSTRIOUS_GUIDANCE_SCALE=7.0
# SDXL_ILLUSTRIOUS_SEED=
#
# --- 槽位 B · ip_adapter（定妆微调，须参考图）---
# IP_ADAPTER_NUM_INFERENCE_STEPS=22         # 默认 28；22 略快
# IP_ADAPTER_GUIDANCE_SCALE=5.0
# IP_ADAPTER_SCALE_DEFAULT=0.55             # 人脸相似度 0.3~0.7
# IP_ADAPTER_SEED=
#
# --- 槽位 C · voice（OmniVoice TTS）---
# OMNIVOICE_EAGER_LOAD=1                    # 启动时预加载+warmup
# OMNIVOICE_WARMUP_INSTRUCT=...             # warmup 用 instruct 文本
#
# Story Studio 定妆/分镜请求可传 width/height/steps/cfg/seed，会覆盖上列 SDXL 默认。

# =============================================================================
# 3. 可选服务（按需取消注释）
# =============================================================================
# --- embed ---
# EMBED_N_CTX=4096
# EMBED_MAX_INPUT_CHARS=4000

# --- ocr ---
# OCR_N_CTX=4096
# OCR_MAX_TOKENS=1536
# OCR_DEFAULT_PROMPT=请识别并输出图片中的全部文字，尽量保持阅读顺序与版面结构。

# --- playwright ---
# PLAYWRIGHT_HEADLESS=1
# PLAYWRIGHT_PROXY=

# =============================================================================
# 附录（默认值见代码，一般不必写入 .env）
# =============================================================================
#
# 端口（service_ctl/specs.py）：
#   llm 8000 · ocr 8001 · emb 8002 · playwright 8003 · voice 8005
#   ip_adapter 8008 · sdxl_juggernaut 8009 · sdxl_illustrious 8010 · scheduler 8012
#
# 首启慢模型超时（秒）：LLM_READY_TIMEOUT_SEC=900 · SDXL_*=900 · OMNIVOICE=120
#
# 下载模型（仓库与路径固定，仅 HF_TOKEN 可配）：
#   uv run python main.py download              # 列出服务
#   uv run python main.py download scheduler    # 调度能力所需模型
#   uv run python main.py download <服务名> …
