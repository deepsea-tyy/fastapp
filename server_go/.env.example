APP_ENV=dev
APP_PORT=9501
APP_WS_PORT=9502
APP_NAME=fastapp

# MySQL
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PREFIX=
# GORM：silent | error | warn | info（info 打印每条 SQL；生产建议 warn / silent）
DB_LOG_LEVEL=warn

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH=
REDIS_DB=0

CACHE_PREFIX=fastapp:

# JWT
JWT_SECRET=
JWT_API_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=7200
JWT_BLACKLIST_TTL=7201

# 数据库 DSN（可选，未使用；实际连接由 DB_* 拼装）
# DATABASE_DSN=user:pass@tcp(127.0.0.1:3306)/fastapp?charset=utf8mb4&parseTime=True
