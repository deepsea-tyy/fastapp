<script setup lang="tsx">
import type { MaProTableExpose, MaProTableOptions, MaProTableSchema } from '@/components/ma-pro-table'
import type { Ref } from 'vue'
import type { TransType } from '@/hooks/auto-imports/useTrans.ts'
import type { UseDrawerExpose } from '@/hooks/useDrawer.ts'

import { deleteByIds, page } from '{{.APIImportPath}}'
import getSearchItems from './data/getSearchItems.tsx'
import getTableColumns from './data/getTableColumns.tsx'
import useDrawer from '@/hooks/useDrawer.ts'
import { useMessage } from '@/hooks/useMessage.ts'
import { ResultCode } from '@/utils/ResultCode.ts'

import Form from './form.vue'

defineOptions({ name: '{{.DefineOptionsName}}' })

const proTableRef = ref<MaProTableExpose>() as Ref<MaProTableExpose>
const formRef = ref()
const selections = ref<any[]>([])
const i18n = useTrans() as TransType
const t = i18n.globalTrans
const msg = useMessage()

const maDrawer: UseDrawerExpose = useDrawer({
  closeOnClickModal: true,
  ok: ({ formType }, okLoadingState: (state: boolean) => void) => {
    okLoadingState(true)
    if (['add', 'edit'].includes(formType)) {
      const elForm = formRef.value.maForm.getElFormRef()
      elForm.validate().then(() => {
        switch (formType) {
          case 'add':
            formRef.value.add().then((res: any) => {
              if (res.code === ResultCode.SUCCESS) {
                msg.success(t('crud.createSuccess'))
                maDrawer.close()
                proTableRef.value.refresh()
              }
              else { msg.error(res.message) }
            }).catch((err: any) => { msg.alertError(err) })
            break
          case 'edit':
            formRef.value.edit().then((res: any) => {
              if (res.code === ResultCode.SUCCESS) {
                msg.success(t('crud.updateSuccess'))
                maDrawer.close()
                proTableRef.value.refresh()
              }
              else { msg.error(res.message) }
            }).catch((err: any) => { msg.alertError(err) })
            break
        }
      }).catch()
    }
    okLoadingState(false)
  },
})

const options = ref<MaProTableOptions>({
  adaptionOffsetBottom: 161,
  header: {
    mainTitle: () => t('{{.PackageLower}}.{{.StructName}}'),
  },
  tableOptions: {
    on: {
      onSelectionChange: (selection: any[]) => selections.value = selection,
      onSortChange: (sort: any) => {
        proTableRef.value.setRequestParams({ order_by: sort.prop, order_by_direction: sort.order === 'ascending' ? 'asc' : 'desc' }, true)
      },
    },
  },
  searchOptions: {
    fold: true,
    text: {
      searchBtn: () => t('crud.search'),
      resetBtn: () => t('crud.reset'),
      isFoldBtn: () => t('crud.searchFold'),
      notFoldBtn: () => t('crud.searchUnFold'),
    },
  },
  searchFormOptions: { labelWidth: '90px' },
  requestOptions: { api: page },
})

const schema = ref<MaProTableSchema>({
  searchItems: getSearchItems(t),
  tableColumns: getTableColumns(maDrawer, formRef, t),
})

function handleDelete() {
  const ids = selections.value.map((item: any) => item.{{.PrimaryKey}})
  msg.confirm(t('crud.delMessage')).then(async () => {
    const response = await deleteByIds(ids)
    if (response.code === ResultCode.SUCCESS) {
      msg.success(t('crud.delSuccess'))
      proTableRef.value.refresh()
    }
  })
}
</script>

<template>
  <div class="mine-layout pt-3">
    <MaProTable ref="proTableRef" :options="options" :schema="schema">
      <template #actions>
        <el-button
          v-auth="['{{.PermPrefix}}:create']"
          type="primary"
          @click="() => {
            maDrawer.setTitle(t('crud.add'))
            maDrawer.open({ formType: 'add' })
          }"
        >
          @{{"{{"}} t('crud.add') {{ print "}}" }}
        </el-button>
      </template>

      <template #toolbarLeft>
        <el-button
          v-auth="['{{.PermPrefix}}:delete']"
          type="danger"
          plain
          :disabled="selections.length < 1"
          @click="handleDelete"
        >
          @{{"{{"}} t('crud.delete') {{ print "}}" }}
        </el-button>
      </template>

      <template #empty>
        <el-empty>
          <el-button
            v-auth="['{{.PermPrefix}}:create']"
            type="primary"
            @click="() => {
              maDrawer.setTitle(t('crud.add'))
              maDrawer.open({ formType: 'add' })
            }"
          >
            @{{"{{"}} t('crud.add') {{ print "}}" }}
          </el-button>
        </el-empty>
      </template>
    </MaProTable>

    <component :is="maDrawer.Drawer">
      <template #default="{ formType, data }">
        <Form ref="formRef" :form-type="formType" :data="data" />
      </template>
    </component>
  </div>
</template>

