{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastApp",
  "version": "1.0.0",
  "identifier": "com.fastapp.desktop",
  "build": {
    "frontendDist": "../splash",
    "beforeBuildCommand": "bash scripts/stage.sh",
    "beforeDevCommand": "bash scripts/stage.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FastApp",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#0f1117"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:* ws://127.0.0.1:* asset: https://asset.localhost; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https: asset: https://asset.localhost ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../build/server/": "bundled/server/",
      "../build/ui/": "bundled/ui/",
      "../build/cmd/": "bundled/cmd/",
      "../build/storage/": "bundled/storage/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {}
}
