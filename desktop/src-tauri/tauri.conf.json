{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryStudio",
  "mainBinaryName": "StoryStudio",
  "version": "1.0.0",
  "identifier": "com.storyStudio.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StoryStudio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#0f1117",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:* ws://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../build/macArm/fastapp": "bundled/fastapp",
      "../build/macArm/ui/": "bundled/ui/",
      "../build/macArm/cmd/": "bundled/cmd/",
      "../build/macArm/storage/": "bundled/storage/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "desktop": {
      "dataDir": "StoryStudio",
      "logo": "assets/logo.png",
      "appPort": 8501,
      "appWsPort": 8502
    }
  }
}
