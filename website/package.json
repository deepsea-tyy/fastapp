{
  "name": "fastapp-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-docs-docsify.mjs && nuxt dev",
    "build": "node scripts/sync-docs-docsify.mjs && nuxt build",
    "generate": "node scripts/sync-docs-docsify.mjs && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "sync-docs": "node scripts/sync-docs-docsify.mjs",
    "test": "playwright test --reporter=list",
    "test:html": "playwright test --reporter=html",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@nuxt/content": "^3.9.0",
    "@nuxtjs/i18n": "^10.2.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "nuxt": "^4.2.1",
    "vue": "^3.5.25",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.14.0",
    "better-sqlite3": "^12.4.6",
    "typescript": "^5.5.0"
  }
}
